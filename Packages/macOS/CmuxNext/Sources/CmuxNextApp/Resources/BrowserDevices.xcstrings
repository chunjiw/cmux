    "browserDevices.notEmulating": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page emulates no device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
