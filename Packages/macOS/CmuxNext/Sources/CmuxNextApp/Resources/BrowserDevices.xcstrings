    "browserDevices.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No device named “%@”. Run Emulate Device… to see the list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”という名前のデバイスはありません。一覧は「デバイスをエミュレート…」で確認できます。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يوجد جهاز باسم “%@”. شغّل «محاكاة جهاز…» لرؤية القائمة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nema uređaja pod imenom “%@”. Pokrenite Emuliraj uređaj… da vidite popis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen enhed med navnet “%@”. Kør Emulér enhed… for at se listen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kein Gerät mit dem Namen „%@“. Führe „Gerät emulieren …“ aus, um die Liste zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No hay ningún dispositivo llamado “%@”. Ejecuta Emular dispositivo… para ver la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucun appareil nommé « %@ ». Lancez Émuler un appareil… pour voir la liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessun dispositivo chiamato “%@”. Esegui Emula dispositivo… per vedere l’elenco."
          }
        },
        "km": {
          "stringUnit": {
            "state": "needs_review",
            "value": "គ្មានឧបករណ៍ឈ្មោះ “%@” ទេ។ ដំណើរការ ត្រាប់តាមឧបករណ៍… ដើម្បីមើលបញ្ជី។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” 기기가 없습니다. 목록을 보려면 기기 에뮬레이션…을 실행하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen enhet med navnet “%@”. Kjør Emuler enhet… for å se listen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brak urządzenia o nazwie „%@”. Uruchom Emuluj urządzenie…, aby zobaczyć listę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nenhum dispositivo chamado “%@”. Execute Emular dispositivo… para ver a lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нет устройства «%@». Выполните «Эмулировать устройство…», чтобы увидеть список."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่มีอุปกรณ์ชื่อ “%@” เรียกใช้ จำลองอุปกรณ์… เพื่อดูรายการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” adlı cihaz yok. Listeyi görmek için Cihaz Öykünmesi…’ni çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Немає пристрою «%@». Виконайте «Емулювати пристрій…», щоб побачити список."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không có thiết bị tên “%@”. Chạy Mô phỏng thiết bị… để xem danh sách."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "没有名为“%@”的设备。运行“模拟设备…”查看列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "沒有名為「%@」的裝置。執行「模擬裝置…」查看列表。"
          }
        }
      }
    },
    "browserDevices.unknownOrientation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown orientation “%@”. Use portrait, landscape, unfolded-portrait or unfolded-landscape."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明な向き“%@”です。portrait、landscape、unfolded-portrait、unfolded-landscape のいずれかを使用してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اتجاه غير معروف “%@”. استخدم portrait أو landscape أو unfolded-portrait أو unfolded-landscape."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nepoznata orijentacija “%@”. Koristite portrait, landscape, unfolded-portrait ili unfolded-landscape."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ukendt retning “%@”. Brug portrait, landscape, unfolded-portrait eller unfolded-landscape."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unbekannte Ausrichtung „%@“. Verwende portrait, landscape, unfolded-portrait oder unfolded-landscape."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Orientación desconocida “%@”. Usa portrait, landscape, unfolded-portrait o unfolded-landscape."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Orientation inconnue « %@ ». Utilisez portrait, landscape, unfolded-portrait ou unfolded-landscape."
          }
        },
        "it": {
          "stringUnit": {
